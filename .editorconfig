# https://editorconfig.org/
# Keeps editors that are not running ruff in line with ruff's output.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# TOML is deliberately not listed here: `pyproject.toml` is committed
# with 4-space indentation, so the [*] default is the one that matches
# what is actually in the tree.
[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
